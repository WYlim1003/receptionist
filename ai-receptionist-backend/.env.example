# ==============================================
# AI Voice Receptionist — Backend Environment
# Copy this to .env and fill in your values
# ==============================================

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Database (PostgreSQL / Supabase) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/voice_receptionist
# For Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ---- Deepgram (Speech-to-Text) ----
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ---- OpenAI (Conversation Engine) ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ---- ElevenLabs (Text-to-Speech) — optional, falls back to Twilio TTS ----
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- App ----
BACKEND_URL=https://your-backend-domain.com
DASHBOARD_URL=http://localhost:5173
FRONTEND_CORS_ORIGINS=http://localhost:5173,https://your-dashboard.vercel.app

# ---- Slot Management ----
SLOT_LOCK_TTL_MINUTES=5
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
